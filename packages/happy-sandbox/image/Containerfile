# happy-sandbox guest: Ubuntu 24.04 LTS, systemd as PID 1, cron, and the
# tools happy needs. The container has no network of its own; the host
# passes its only interface (a TAP) in. This is the base; provision.sh adds
# Node, claude, codex and happy into /home/dev through that network.
FROM docker.io/library/ubuntu:24.04

# APT_MIRROR only speeds up this build (e.g. --build-arg
# APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu); the image keeps the
# official archive, so a sandbox's own `apt install` goes to Ubuntu directly
# (through its exit, wherever that is).
ARG APT_MIRROR=
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8

RUN src=/etc/apt/sources.list.d/ubuntu.sources \
 && cp "$src" /tmp/ubuntu.sources.official \
 && if [ -n "$APT_MIRROR" ]; then sed -i "s#http://archive.ubuntu.com/ubuntu#${APT_MIRROR}#g; s#http://security.ubuntu.com/ubuntu#${APT_MIRROR}#g" "$src"; fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus cron sudo ca-certificates curl iproute2 iputils-ping dnsutils netcat-openbsd \
      git tar xz-utils gzip unzip less nano procps tzdata locales \
      build-essential libatomic1 python3 python3-venv \
      # Everyday tools (owner, 2026-11-18): editors, search, inspection, ssh client.
      vim jq rsync ripgrep tree htop file zip lsof strace openssh-client \
      # What a headless Chromium needs (Playwright and the like download the
      # browser itself into the home), and fonts so screenshots show CJK text.
      libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 \
      libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
      fonts-liberation fonts-noto-cjk fonts-noto-color-emoji \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 # Back to the official archive (the mirror was for this build only).
 && mv /tmp/ubuntu.sources.official "$src" \
 # Locales a sandbox may take (identity.json; default en_US.UTF-8).
 && sed -i -E 's/^# *(en_US.UTF-8|en_GB.UTF-8|de_DE.UTF-8|fr_FR.UTF-8|ja_JP.UTF-8|zh_CN.UTF-8) UTF-8/\1 UTF-8/' /etc/locale.gen \
 && locale-gen \
 # No machine identity in the image: each sandbox gets its own (identity.json,
 # mounted at /etc/machine-id). dbus writes its own at install time: replace it
 # with a link, so dbus reads the sandbox's.
 && rm -f /var/lib/dbus/machine-id && : > /etc/machine-id && ln -s /etc/machine-id /var/lib/dbus/machine-id \
 # Services a container does not need (and that would wait for a network or hardware).
 && systemctl mask systemd-networkd.service systemd-networkd-wait-online.service systemd-resolved.service \
      systemd-timesyncd.service systemd-machine-id-commit.service getty@tty1.service console-getty.service systemd-logind.service \
      apt-daily.timer apt-daily-upgrade.timer motd-news.timer e2scrub_reap.service 2>/dev/null || true \
 && systemctl enable cron.service \
 # The journal lives in memory: no log files in the image or the container layer.
 && mkdir -p /etc/systemd/journald.conf.d && printf '[Journal]\nStorage=volatile\n' > /etc/systemd/journald.conf.d/volatile.conf \
 # One working user, `dev` (uid 1000 here; hsb-setup gives it the host user's
 # uid at first boot). Its home is a volume, filled from this image.
 && (userdel -r ubuntu 2>/dev/null || true) \
 && useradd -m -u 1000 -U -s /bin/bash dev \
 && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev && chmod 440 /etc/sudoers.d/dev

# The guest's own files (build context: the package, .containerignore keeps
# it to internal/sandbox/guest). happy-sandbox embeds the same files and
# mounts or writes them over these at every start, so a sandbox runs its
# happy-sandbox's version.
COPY internal/sandbox/guest/hsb-setup.sh internal/sandbox/guest/hsb-packages.sh internal/sandbox/guest/hsb-apt-record.sh /usr/local/lib/happy-sandbox/
COPY internal/sandbox/guest/hsb-setup.service internal/sandbox/guest/hsb-packages.service /etc/systemd/system/
COPY internal/sandbox/guest/99happy-sandbox /etc/apt/apt.conf.d/99happy-sandbox
# apt-baseline: the image's own packages; what the user adds on top is
# recorded by the apt hook and comes back after a recreation.
RUN chmod 755 /usr/local/lib/happy-sandbox/hsb-setup.sh /usr/local/lib/happy-sandbox/hsb-packages.sh \
      /usr/local/lib/happy-sandbox/hsb-apt-record.sh \
 && apt-mark showmanual | sort -u > /usr/local/lib/happy-sandbox/apt-baseline \
 && systemctl enable hsb-setup.service hsb-packages.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
